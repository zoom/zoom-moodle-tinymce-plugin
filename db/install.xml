<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="lib/editor/tiny/plugins/zoomclassroom/db" VERSION="2026080100" COMMENT="XMLDB file for tiny_zoomclassroom"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="tiny_zoomclassroom_emb" COMMENT="Server-side launch metadata for persisted Zoom Classroom embeds">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="publicid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="toolid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="launchconfigjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="publicid_uix" UNIQUE="true" FIELDS="publicid"/>
                <INDEX NAME="courseid_ix" UNIQUE="false" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
